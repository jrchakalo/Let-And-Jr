# ============================================================
# Supabase — https://app.supabase.com/project/_/settings/api
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# Mercado Pago — https://www.mercadopago.com.br/developers
# ============================================================
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=chave-secreta-do-webhook-no-painel-mp

# URL base da aplicação (para callbacks do MP)
NEXT_PUBLIC_BASE_URL=https://seu-site.vercel.app

# ============================================================
# Admin Panel — senha simples para acesso ao /admin
# ============================================================
ADMIN_PASSWORD=troque-por-uma-senha-segura

# ============================================================
# Vercel Cron Security (opcional — protege o endpoint de cron)
# ============================================================
# Gere com: openssl rand -base64 32
CRON_SECRET=gere-com-openssl-rand-base64-32
